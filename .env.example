# 오류 보고(@kwoncheulJin/error-snapshot) — 이 앱 전용 Firebase 프로젝트 설정.
# 값은 커밋하지 말고 .env.local 에 넣는다(gitignore). 필수 셋(API_KEY, PROJECT_ID,
# STORAGE_BUCKET) 중 하나라도 비면 오류 보고 기능이 꺼진 채로 빌드된다.
VITE_ERROR_SNAPSHOT_FIREBASE_API_KEY=
VITE_ERROR_SNAPSHOT_FIREBASE_PROJECT_ID=
VITE_ERROR_SNAPSHOT_FIREBASE_STORAGE_BUCKET=
VITE_ERROR_SNAPSHOT_FIREBASE_AUTH_DOMAIN=
VITE_ERROR_SNAPSHOT_FIREBASE_MESSAGING_SENDER_ID=
VITE_ERROR_SNAPSHOT_FIREBASE_APP_ID=
