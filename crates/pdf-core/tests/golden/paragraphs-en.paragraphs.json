        {"number":1,"text":"Appendix: Sync Limits","bounds":{"page":1,"x":72.056,"y":716.738,"w":142.674,"h":14.574036},"fontSize":14.0,"heading":true},
        {"number":2,"text":"Each account can sync up to five devices at the same time. Older devices may need an update before they can sign in.","bounds":{"page":1,"x":73.012,"y":682.261,"w":368.53293,"h":27.170044},"fontSize":11.0,"heading":false},
        {"number":3,"text":"Large attachments are uploaded only on Wi-Fi to save mobile data.","bounds":{"page":1,"x":73.111,"y":658.86096,"w":339.96597,"h":11.627014},"fontSize":11.0,"heading":false}
      ]
    }
  }
