    "@fontsource/ibm-plex-sans-kr": "^5.3.0",
    "@kwoncheulJin/error-snapshot": "^0.1.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "~2.8.2",
    "@tauri-apps/plugin-log": "~2.10.1",
    "@tauri-apps/plugin-opener": "~2.7.1",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-store": "~2.5.0",
