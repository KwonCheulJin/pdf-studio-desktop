{
  "name": "pdf-studio-desktop",
  "productName": "pdf-studio-desktop",
  "version": "2.1.0",
  "description": "PDF 병합·편집·TIFF 변환 데스크톱 앱 (Tauri v2)",
  "scripts": {
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "validate": "pnpm lint && pnpm typecheck && pnpm test",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "dev:web": "vite",
    "build:web": "vite build",
    "tauri": "tauri",
    "fetch:pdfium": "node scripts/fetch-pdfium.mjs",
    "fetch:ocr": "node scripts/fetch-ocr.mjs",
    "licenses:generate": "node scripts/generate-notices.mjs",
    "licenses:check": "node scripts/check-licenses.mjs"
  },
  "keywords": [],
  "author": {
    "name": "KwonCheulJin",
    "email": "chkftm12@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2.12.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.57.2",
    "vite": "^8.0.3",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.2"
