{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PDF Studio",
  "version": "../package.json",
  "identifier": "io.github.kwoncheuljin.pdfstudio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": "pnpm build:web"
  },
  "app": {
    "windows": [
      {
        "title": "PDF Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https://firestore.googleapis.com; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "ocr-models/ch_PP-OCRv5_det_mobile.onnx": "ocr-models/ch_PP-OCRv5_det_mobile.onnx",
      "ocr-models/korean_PP-OCRv5_rec_mobile.onnx": "ocr-models/korean_PP-OCRv5_rec_mobile.onnx",
      "ocr-models/ppocrv5_korean_dict.txt": "ocr-models/ppocrv5_korean_dict.txt"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "frameworks": [
        "pdfium/aarch64-apple-darwin/libpdfium.dylib",
        "onnxruntime/aarch64-apple-darwin/libonnxruntime.dylib"
      ],
      "signingIdentity": "-",
      "entitlements": "./Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5Q0VFOUE4NTUyM0U1NEUKUldSTzVTTlZxT25PV2I4enBqcWdZSFMvS01SV0lxemh1VE81WDdYMXNBQ3V0WWRIc1pPM0drMHUK",
      "endpoints": [
        "https://github.com/KwonCheulJin/pdf-studio-desktop/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
